# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el ".env" real a un repositorio.

# --- Base de datos (Supabase) ---
# La encuentras en: Supabase > Project Settings > Database > Connection string (URI)
# Usa el connection string en modo "Session" (puerto 5432) si tu backend corre
# permanentemente (servidor propio); usa "Transaction" (puerto 6543, pgbouncer)
# solo si vas a desplegar en serverless — en ese caso, SET LOCAL dentro de una
# misma transacción (ver tenant.middleware.js) igual funciona porque abrimos
# transacción explícita en cada request.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.ygerovhafvfpzygerdew.supabase.co:5432/postgres

# --- Autenticación ---
JWT_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# --- Servidor ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
